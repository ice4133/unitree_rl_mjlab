Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 40; 40; 40
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 30
  - Class: rviz_default_plugins/Map
    Name: SLAM Map
    Enabled: true
    Alpha: 0.7
    Topic:
      Value: /map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/PointCloud2
    Name: Filtered Lidar
    Enabled: true
    Size (m): 0.025
    Style: Points
    Color Transformer: AxisColor
    Topic:
      Value: /perception/lidar/points_filtered
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  - Class: rviz_default_plugins/LaserScan
    Name: Scan
    Enabled: true
    Size (m): 0.035
    Style: Points
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
    Show Axes: true
    Marker Scale: 0.3
  - Class: rviz_default_plugins/Path
    Name: Global Plan
    Enabled: true
    Line Style: Lines
    Line Width: 0.04
    Color: 40; 240; 40
    Topic:
      Value: /plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
  - Class: rviz_default_plugins/Path
    Name: Local Plan
    Enabled: true
    Line Style: Lines
    Line Width: 0.04
    Color: 40; 240; 40
    Topic:
      Value: /local_plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
  - Class: rviz_default_plugins/Map
    Name: Global Costmap
    Enabled: true
    Alpha: 0.4
    Color Scheme: costmap
    Topic:
      Value: /global_costmap/costmap
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/Map
    Name: Local Costmap
    Enabled: true
    Alpha: 0.4
    Color Scheme: costmap
    Topic:
      Value: /local_costmap/costmap
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Pitch: 0.9
      Yaw: -1.2
      Focal Point:
        X: 2
        Y: 0
        Z: 0
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/Measure
  - Class: nav2_rviz_plugins/GoalTool
Window Geometry:
  Width: 1280
  Height: 800
